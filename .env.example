# ── Supabase ────────────────────────────────────────────────────────────────
# Project URL and anon (public) key from your Supabase project settings.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key — server-only. Used to resolve public share links bypassing
# RLS in a controlled, server-side way. NEVER expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Anthropic (Claude) ──────────────────────────────────────────────────────
# Used for AI meal-plan generation (claude-sonnet-4-6).
ANTHROPIC_API_KEY=sk-ant-...

# ── Google OAuth / Calendar ─────────────────────────────────────────────────
# Configure Google as a provider in Supabase Auth. The calendar.readonly scope
# is requested at sign-in so we can read evening events.
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ── App ─────────────────────────────────────────────────────────────────────
# Public base URL of the deployment (used to build share links).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
